# Local development only. Copy to .env and set your own password.
# Keep the user/database names below for the Week 0 example commands.
COMPOSE_PROJECT_NAME=courtiq
POSTGRES_USER=courtiq
POSTGRES_DB=courtiq
POSTGRES_PASSWORD=
# Host port; change to 5433 if another service already uses 5432.
POSTGRES_PORT=5432
# Generated privately by: python scripts/database.py setup
# Application access is read-only; keep the admin password for maintenance.
COURTIQ_APP_USER=courtiq_app
COURTIQ_APP_PASSWORD=
